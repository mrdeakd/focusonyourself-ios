              "name": "sp7",
              "width": "fill_container",
              "height": 16
            },
            {
              "type": "text",
              "id": "5XhV8",
              "name": "h3",
              "fill": "#1C1C1C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Starting a daily practice",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "rectangle",
              "id": "qZteE",
              "name": "sp8",
              "width": "fill_container",
              "height": 8
            },
            {
              "type": "text",
              "id": "gc7Ty",
              "name": "p3",
              "fill": "#1C1C1C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "You dont need hours of meditation to see results. Research shows that as little as 10 minutes per day of focused breathing and present-moment awareness can reduce stress hormones and improve mood within two weeks.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        }
      ]
