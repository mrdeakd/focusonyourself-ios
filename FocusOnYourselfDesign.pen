            },
            {
              "type": "text",
              "id": "KLO5b",
              "name": "p1",
              "fill": "#1C1C1C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Mindfulness has been practiced for thousands of years, but modern science is now confirming what ancient traditions have long known: taking a few minutes each day to focus on the present moment can transform your mental health.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "rectangle",
              "id": "IfHwH",
              "name": "sp5",
              "width": "fill_container",
              "height": 16
            },
            {
              "type": "text",
              "id": "aGhMu",
              "name": "h2",
              "fill": "#1C1C1C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "What happens in the brain",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "rectangle",
              "id": "RDz4t",
              "name": "sp6",
              "width": "fill_container",
              "height": 8
            },
            {
              "type": "text",
              "id": "ilm6q",
              "name": "p2",
              "fill": "#1C1C1C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "When you practice mindfulness regularly, studies show measurable changes in the prefrontal cortex, the region responsible for emotional regulation, decision-making, and self-awareness.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "rectangle",
